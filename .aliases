alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."

alias diff="diff --color=auto -u"
alias l="ls"
alias ll="ls -l"
alias la="ls -a"
alias lal="ls -al"
alias t="tree -C"
# these replace the ls/tree ones above where eza is installed (skipped otherwise);
# ls itself stays GNU ls, since eza's short flags differ (e.g. ls -ltr)
alias l="eza -F --icons --group-directories-first"
alias ll="eza -lF --icons --git --group-directories-first"
alias la="eza -aF --icons --group-directories-first"
alias lal="eza -alF --icons --git --group-directories-first"
alias t="eza -F --icons --tree"
alias md="mkdir -p"
alias grep="grep --color=auto --exclude-dir=.git"
alias rtw='sed --in-place '"'"'s/[[:space:]]\+$//'"'"''

alias g="git"
alias gst="git status"
alias gd="git diff"
alias gsta="git stash"
alias gstp="git stash pop"
alias gc="git commit -v"
alias gca="gc -a"
alias gc!="gc --amend"
alias gca!="gc -a --amend"
alias ga="git add"
alias gco="git checkout"
alias gr="git reset"
alias grhh="git reset --hard HEAD"
alias gp="git push"
alias gpsu="gp --set-upstream"
alias gf="git fetch"
alias gl="git pull --rebase"
alias grb="git rebase"
alias grbc="git rebase --continue"
alias grba="git rebase --abort"

alias flatseal="flatpak run com.github.tchx84.Flatseal"
alias steam="flatpak run com.valvesoftware.Steam"
alias hgl="flatpak run com.heroicgameslauncher.hgl"
