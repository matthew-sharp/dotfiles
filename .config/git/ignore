# Shared dotfile: linked from ~/dotfiles by setup.sh, applies to every machine.
# Global gitignore. There is no per-machine file (for one repo only, use its
# .git/info/exclude); only edit here for patterns all machines should get.

# editor and OS clutter
*.swp
*.swo
*~
.DS_Store
.idea/
.bsp/
.netrwhist

# patch and merge leftovers: patch(1) backups and rejects, git mergetool copies
*.orig
*.rej
*_BACKUP_[0-9]*
*_BASE_[0-9]*
*_LOCAL_[0-9]*
*_REMOTE_[0-9]*

# per-checkout Claude Code notes
CLAUDE.local.md
